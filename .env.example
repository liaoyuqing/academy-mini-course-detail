# 复制为 .env 并按实际部署环境填写；仓库内不保存任何真实值。
# 应用
APP_NAME=academy-mini-api
# prod / staging 走真实下游；mock / dev / local 使用本地替身，不需要任何外部后端
APP_ENV=prod
LOG_LEVEL=INFO

# 数据库：PostgreSQL 16（生产）或 sqlite（本地演示）
DATABASE_URL=postgresql+psycopg://app_user:change_me@127.0.0.1:5432/academy
# 本地演示可用下面这行
# DATABASE_URL=sqlite+pysqlite:///./demo.sqlite3

# 缓存
REDIS_URL=redis://127.0.0.1:6379/0

# S2-CRM（企业能力卡来源）：只取简称/行业/能力标签/一句话简介
CRM_API_BASE=https://crm.internal.example/api
CRM_API_KEY=
CRM_TIMEOUT_SECONDS=2.0

# 报名资格校验服务（12 种 signup_state 的唯一判定方）
ENROLLMENT_API_BASE=https://enrollment.internal.example/api
ENROLLMENT_API_KEY=
ENROLLMENT_TIMEOUT_SECONDS=1.5

# S3-MINI 小程序登录态
MINI_API_BASE=https://mini.internal.example/api
# token=contact_id 的映射，生产由小程序网关下发，不写在仓库里
MINI_API_KEY=
